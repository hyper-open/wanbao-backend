# ============================================================
# 万宝工具箱后端环境变量示例
# 复制为 .env 后按需修改；所有项均有代码内默认值，可只填需要覆盖的项。
# 上线前必改：JWT_SECRET / ADMIN_PASSWORD / 各 API_KEY（见 docs/compliance-checklist.md）。
# ============================================================

# ---------- 应用 ----------
# 生产务必改为强随机值（如 openssl rand -hex 32）
JWT_SECRET=change-me-in-prod
JWT_ALGO=HS256

# ---------- 数据库（复用已有 MySQL @host.docker.internal:23306，自动建库 wanbao） ----------
DATABASE_URL=mysql+pymysql://user:password@host.docker.internal:3306/wanbao
# 仅用于启动时建库/授权（需要 root 权限）
MYSQL_ROOT_URL=mysql+pymysql://root:PASSWORD@host.docker.internal:23306
DB_ECHO=false

# ---------- Redis（复用已有 @host.docker.internal:26379；用于队列/限流/缓存） ----------
REDIS_URL=redis://127.0.0.1:26379/0

# ---------- 对象存储 S3 兼容（复用已有 rustfs @127.0.0.1:29000） ----------
S3_ENDPOINT=http://host.docker.internal:29000
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=wanbao
S3_REGION=us-east-1

# 初始管理员账号：首次 seed 时创建，密码上线前务必改强随机值
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-prod

# ---------- 附件 ----------
# 单文件上限（字节），默认 10MB
ATTACHMENT_MAX_BYTES=10485760
# 允许的 MIME 白名单（docx/pptx/pdf/txt/md）
ATTACHMENT_ALLOWED_MIME=application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/pdf,text/plain,text/markdown

# ---------- 结果文件下载（presigned URL 有效期，秒） ----------
PRESIGN_EXPIRES_SECONDS=3600

# ---------- 网关熔断（§7.2） ----------
# 连续失败 N 次标 down，冷却 M 秒后半开重试
CB_FAILURE_THRESHOLD=3
CB_COOLDOWN_SECONDS=60

# ---------- 异步任务（§16.2/可靠性） ----------
# pending 超时由 reaper 标失败并退次
PENDING_TIMEOUT_MINUTES=10

# ---------- 镜像构建（仅 docker compose build 使用，运行时无影响） ----------
# 基础镜像，默认 python:3.13-slim（Docker Hub）。可覆盖为本地/内网可达的镜像，例如：
# BASE_IMAGE=docker.m.daocloud.io/library/python:3.13-slim

# ---------- 交互式多轮会话（§6.5 工具图内人工介入） ----------
# 会话有效期（awaiting 阶段超时则 expired；后台可覆盖，仅对新会话生效）
# 最多追问轮次（可由 tool.interaction_config.max_rounds 覆盖）
SESSION_MAX_ROUNDS=5
# 同一用户未付费活跃会话上限（防白嫖；后台可覆盖，仅对新会话生效）
# running 卡死回收阈值（分钟）
SESSION_STEP_TIMEOUT_MINUTES=10
# 图内受限工具调用最大轮次
SESSION_MAX_TOOL_ROUNDS=2

# worker 消费线程数（BLPOP 对多消费者原子安全；reaper 仅 0 号线程执行）
WORKER_CONCURRENCY=2
